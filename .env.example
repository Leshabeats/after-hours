# Optional. Without it, GitHub search falls back to the baked seed catalog.
GITHUB_TOKEN=

# GitHub OAuth for the account journal. Create an OAuth App:
# Homepage: http://127.0.0.1:5173
# Callback: http://127.0.0.1:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173

# Persistent SQLite directory. In production use an absolute path on a mounted disk.
DATA_DIR=./data

# Session signing key, 32+ chars; required in production.
# In development a file in DATA_DIR is created if empty.
AUTH_SECRET=
