# Copy to .env.local. Dev/start/migration commands load this file explicitly.
# Separate Neon Free project, Frankfurt eu-central-1; Vercel Functions fra1.
# Development branch only. Runtime uses the pooled hostname (-pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct hostname for npm run db:migrate. Never expose either URL to the browser.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional GitHub catalog/history token. No user GitHub access tokens are stored.
GITHUB_TOKEN=

# Existing local OAuth App; preserve the 127.0.0.1 callback.
# Homepage: http://127.0.0.1:5173
# Callback: http://127.0.0.1:5173/api/auth/callback
# Production uses a separate OAuth App for the real production hostname.
# Leave credentials unset in Vercel Preview; VERCEL_ENV=preview also disables OAuth.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173

# Stable random session key, at least 32 bytes. Required in production/Preview.
AUTH_SECRET=
# Development signing-secret fallback only; no database files are stored here.
DATA_DIR=./data

# Tests never load .env.local or use DATABASE_URL. For local integration checks,
# export TEST_DATABASE_URL for an ephemeral local PostgreSQL database named *_test.
# CI supplies PostgreSQL 17; local Docker is optional and not needed for app dev.
