# Optional. Without it, GitHub search falls back to the baked seed catalog.
GITHUB_TOKEN=

# Optional. Without it, "Разбор ночи" stays disabled.
XAI_API_KEY=

# GitHub OAuth for the account journal. Create an OAuth App:
# Homepage: http://127.0.0.1:5173
# Callback: http://127.0.0.1:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173

# Session signing key, 32+ chars. Locally a file in data/ is created if empty.
AUTH_SECRET=
